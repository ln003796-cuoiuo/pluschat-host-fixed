Options -Indexes
DirectoryIndex public/index.php

RewriteEngine On

# Feature PHP files are included by public/index.php and must not be called directly.
RewriteRule ^(?:admin|password|calls|channels|chats|chatprefs|files|stories|friends|groups|login|messages|notifications|polls|profile|register|saved|search|security|topics|users|tests|api/integrations)/.*\.php$ - [F,L,NC]

# Keep source, configuration and database files out of public access.
RewriteRule ^(?:bootstrap\.php|config(?:\.example)?\.php|confirm\.php|database(?:/|$)|storage(?:/|$)|\.git(?:/|$)) - [F,L,NC]

# Expose only the password recovery page.
RewriteRule ^password-reset\.php$ public/password-reset.php [QSA,L]

# Route API URLs to the single PHP entry point.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]

<FilesMatch "^(?:config(?:\.example)?\.php|confirm\.php|bootstrap\.php|\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>
